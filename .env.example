# Django Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
# Or leave empty for development SQLite fallback:
# DATABASE_URL=

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Library Business Rules
DEFAULT_BORROW_DAYS=14
FINE_PER_DAY=1.00
MAX_BOOKS_BORROWED_STUDENT=3
MAX_RESERVATIONS_STUDENT=3
RESERVATION_EXPIRY_DAYS=3

# Media & Static Storage
MEDIA_ROOT_PATH=media
STATIC_ROOT_PATH=staticfiles
